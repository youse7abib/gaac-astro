{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(html|js)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "GAAC-2026-data/**",
      "**/*.csv",
      "**/*.xlsx",
      "auth-export.json",
      "all-registered-emails.txt",
      "serviceAccountKey.json",
      ".env",
      "functions/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  }
}
