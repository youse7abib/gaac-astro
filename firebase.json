{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "GAAC-2026-data/**",
      "**/*.csv",
      "**/*.xlsx",
      "auth-export.json",
      "all-registered-emails.txt",
      "serviceAccountKey.json",
      ".env"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  }
}
